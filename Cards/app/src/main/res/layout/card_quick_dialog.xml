<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="vertical">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quick_code_island"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/code_details_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/code_details"
                android:textColor="@color/app_text_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/code_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/please_scan_code"
                android:textColorHint="@color/app_text_secondary"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/close_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close"
            android:scaleType="fitCenter"
            app:tint="@color/app_icon_primary"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/code_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/app_surface_var">

        <LinearLayout
            android:id="@+id/code_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp">

            <ImageView
                android:id="@+id/code_img"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-2dp"
            android:background="@color/app_stroke"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/type_lay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/type_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/none"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <ImageView
                    android:id="@+id/dropdown_img"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_dropdown"
                    android:scaleType="fitCenter"
                    app:tint="@color/app_icon_primary"
                    android:visibility="gone"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

            </LinearLayout>

            <EditText
                android:id="@+id/code_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="8dp"
                android:gravity="end"
                android:background="@null"
                android:text="@string/none"
                android:hint="@string/enter_code"
                android:textColorHint="@color/app_text_hint"
                android:textColor="@color/app_text_secondary"
                android:textSize="16sp"
                android:singleLine="true"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

<FrameLayout android:id="@+id/quick_photos_section"
 android:layout_width="match_parent" android:layout_height="184dp"
 android:layout_marginTop="12dp" android:clipToOutline="true">
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/quick_photos"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:padding="12dp" android:clipToPadding="false"
  android:overScrollMode="never" android:scrollbars="horizontal"/>
 <View android:id="@+id/photo_fade_left"
  android:layout_width="10dp" android:layout_height="match_parent"
  android:layout_gravity="left"
  android:importantForAccessibility="no"/>
 <View android:id="@+id/photo_fade_right"
  android:layout_width="10dp" android:layout_height="match_parent"
  android:layout_gravity="right"
  android:importantForAccessibility="no"/>
</FrameLayout>
</LinearLayout>
